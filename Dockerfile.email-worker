# syntax=docker/dockerfile:1
# BullMQ email worker — same queue as `lib/email-queue.ts` (requires REDIS_URL).
# Build: docker compose build email-worker
# tsx remains available via devDependencies after `npm ci` (NODE_ENV not set during install).

FROM node:22-alpine
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG DATABASE_URL=postgresql://linksy:linksy123@postgres:5432/linksy
ENV DATABASE_URL=$DATABASE_URL
RUN npx prisma generate

ENV NODE_ENV=production

CMD ["npx", "tsx", "scripts/email-worker.ts"]
