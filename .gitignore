# User-uploaded content (UPLOAD_STORAGE=local mode writes here for dev).
# In production set UPLOAD_STORAGE=s3 or vercel_blob — see lib/uploads-storage.ts.
# The directory itself is kept (via .gitkeep) but uploaded files never enter the repo.
public/uploads/*
!public/uploads/.gitkeep
