{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Asia/Ulaanbaatar)"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "schedule": ["before 9am on monday"],
  "packageRules": [
    {
      "matchPackageNames": ["next", "react", "react-dom", "eslint-config-next"],
      "groupName": "next and react"
    },
    {
      "matchPackagePatterns": ["^@prisma/", "^prisma$"],
      "groupName": "prisma"
    },
    {
      "matchPackagePatterns": ["^@playwright/", "^@vitest/", "^vitest$"],
      "groupName": "test tooling"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
