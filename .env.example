# =============================================================================
# Linksy — Environment variables
# =============================================================================
# Энэ файл бол **зөвхөн жишээ** (template). Шууд бүү ашигла:
#
#   1. Local dev:    `cp .env.example .env` → дараа нь нууцаа бөглө.
#   2. Production:   Файлд commit БҮҮ хий. Нууцыг host / secret manager-ээс
#                    inject хий (Vercel env, AWS Secrets Manager, k8s Secret,
#                    Doppler, Infisical гэх мэт).
#
# Хэсэг бүрт **3 төрлийн** ENV:
#   🔴 MUST-SET      — энэ ENV байхгүй бол апп бүрэн ажиллахгүй
#   🟡 RECOMMENDED   — production-д заавал тохируулах (feature идэвхгүй болно)
#   🟢 OPTIONAL      — default бэлэн, өөрчилмөөр бол set хий
#
# Production deploy-ийн өмнө: PROJECT_GAPS_AUDIT.md §5 "Pre-launch Checklist".
#
# Random secret үүсгэх:
#   Linux/Mac:  `openssl rand -base64 32`
#   PowerShell: `[Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))`
# =============================================================================


# =============================================================================
# 🔴 MUST-SET — Эдгүй бол апп ажиллахгүй
# =============================================================================

# Session-token (JWT) signing secret. Long-lived, нэг л удаа үүсгэ.
# Production-д солих төлөвлөгөө + downtime + multi-replica зааварчилгаа:
# docs/SECRETS_ROTATION.md
JWT_SECRET=

# Primary Postgres connection (Prisma). Production-д PgBouncer ашиглах бол
# `?pgbouncer=true&connection_limit=1` нэмж транзакци-горим тохируул.
# Доорх default нь docker-compose-той тааруулсан local Postgres-тэй.
DATABASE_URL=postgresql://linksy:linksy123@localhost:5432/linksy

# App-ын ил харагдах хаяг. Email link, OAuth callback, OG image URL бүгд
# энэ-ээс эх үүсвэр. Production-д **HTTPS** + бодит домэйн (жнь
# https://linksy.app). DEV-д http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron endpoint-уудыг гадаад хүсэлтээс хамгаалах токен. Бүх
# `/api/cron/*` route `Authorization: Bearer $CRON_SECRET` шалгана.
# Random 32+ char. PROJECT_GAPS_AUDIT.md §5 дотор бичсэн cron schedule-той
# хосолно.
CRON_SECRET=


# =============================================================================
# 🟡 RECOMMENDED — Production-д заавал тохируулах
# =============================================================================

# -----------------------------------------------------------------------------
# Redis — олон production feature-д шаардлагатай:
#   • Email queue (BullMQ)
#   • Presence / typing / message bus (SSE fan-out across instances)
#   • Rate-limit counters
#   • Leaderboards (sorted-sets)
#   • DAU/MAU HyperLogLog (`linksy_active_users_*` metrics)
#   • Refresh-token rotation single-flight (concurrent-401 cascade-аас сэргийлнэ)
# REDIS_URL хоосон бол эдгээр feature нь in-process fallback ашиглах эсвэл
# идэвхгүй болно. Production-д заавал set хий.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Docker Compose дотор `linksy_redis` service-ийг автоматаар тэмдэг хийнэ.
# Compose-д `COMPOSE_REDIS_URL=redis://redis:6379` override бэлэн.

# Email queue-ийг тусдаа worker process-руу route хийх. `1` → REDIS_URL
# заавал хэрэгтэй. `0` (default) дээр web сервер inline илгээдэг → load-той
# үед request-уудыг удаашруулна.
EMAIL_QUEUE_ENABLED=1

# -----------------------------------------------------------------------------
# Sentry — алдаа болон performance трayшайс
# -----------------------------------------------------------------------------
# Project DSN (Sentry → Settings → Projects → [your project] → Client Keys).
# Хоёр копи: server-side + client-side (бичсэн хувилбар нь NEXT_PUBLIC_).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# CI build үед source-maps upload + release create + commit metadata.
# Sentry → Settings → Account → API → Auth Tokens →
#   "project:write" + "release:admin" scope.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Build-ийн release identifier. CI-д `${{ github.sha }}` өгдөг.
# Local-д empty → Sentry auto-assign.
# SENTRY_RELEASE=

# Trace sampling rate. Production default 0.05 (5%), dev 1 (100%).
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# CPU profiling sample rate. Set-сэн үед `@sentry/profiling-node` ачаална
# (native binary). Хоосон → profiling off.
# SENTRY_PROFILES_SAMPLE_RATE=0.02

# Session Replay sampling — privacy-first defaults
# (`maskAllText, maskAllInputs, blockAllMedia` instrumentation-client.ts-д).
# session=0 / on-error=1 нь "alert-only" recommended setup.
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_RATE=1

# Environment tag. Production-д "production", staging-д "staging".
# SENTRY_ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Prometheus `/api/metrics` scrape хамгаалах
# -----------------------------------------------------------------------------
# Random 32+ char. Scraper-руу `bearer_token` дамжуулна:
#
#   # prometheus.yml
#   - job_name: linksy
#     bearer_token: <тэр л утга>
#     metrics_path: /api/metrics
#     static_configs:
#       - targets: ['linksy-web:3000']
#
# Хоосон үлдээвэл /api/metrics нь анонимоор уншигдана (зөвхөн private
# network-д ажиллах k8s service хязгаарласан тохиргоонд аюулгүй).
# METRICS_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# OpenTelemetry — Tempo / Jaeger / Datadog / New Relic / Honeycomb
# -----------------------------------------------------------------------------
# OTLP/HTTP collector endpoint. Вендор бүр өөрийн OTLP gateway өгдөг.
# Set хийсэн үед `@opentelemetry/sdk-node` ачаалж span-уудыг илгээнэ.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTEL_SERVICE_NAME=linksy
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey%20abcdef123

# -----------------------------------------------------------------------------
# Stripe — Subscription + Tip + Webhook
# -----------------------------------------------------------------------------
# Test mode: `sk_test_…` + `whsec_…`. Live mode: `sk_live_…` + `whsec_…`.
# Stripe Dashboard → Developers → API keys, Webhooks.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Publishable key for client-side Embedded Checkout (`@stripe/stripe-js`).
# Test key starts with `pk_test_…`, live with `pk_live_…`.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Stripe automatic tax. Off by default; flip to `true` after registering
# tax IDs in Stripe Dashboard (Settings → Tax → Registrations). Affects
# Subscription Checkout sessions only.
# STRIPE_AUTOMATIC_TAX=false
#
# Price ID-ууд (Stripe Dashboard → Products → Pricing → "Copy ID"):
# Pro tier нь нэг л байна — monthly эсвэл yearly-ийг сонгож boldog.
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
#
# Customer Portal-ийн return URL fallback (degraded UI fallback;
# бодит portal session-ийг сервер өөрөө үүсгэдэг).
# BILLING_PORTAL_URL=https://billing.stripe.com/session/...

# -----------------------------------------------------------------------------
# AI assistant — Google Gemini
# -----------------------------------------------------------------------------
# Google AI Studio → Get API key (https://aistudio.google.com/app/apikey)
# Server-only — never exposed to the browser. Powers /api/ai/* (chat,
# caption, reply, summarize). Leave empty to keep AI features disabled.
GEMINI_API_KEY=
# Optional override for the default model. Leave commented to use
# gemini-2.5-flash (fast + free tier-friendly).
# GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Email provider — Resend
# -----------------------------------------------------------------------------
# Resend → Dashboard → API Keys. Domain нэмж SPF/DKIM/DMARC баталгаажуулах.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=noreply@your-domain.com

# -----------------------------------------------------------------------------
# Media storage — S3 (эсвэл S3-compatible: R2, MinIO, B2)
# -----------------------------------------------------------------------------
# UPLOAD_STORAGE=s3 болгосны дараа доорх 5 талбарыг бөглө. Хоосон бол local
# disk (`/uploads`) ашиглана — multi-replica deploy-д буруу.
# UPLOAD_STORAGE=s3
# S3_UPLOAD_BUCKET=linksy-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_UPLOAD_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://linksy-uploads.s3.us-east-1.amazonaws.com
#
# CDN ашиглах бол:
# NEXT_PUBLIC_MEDIA_CDN_BASE=https://cdn.linksy.app

# -----------------------------------------------------------------------------
# Web Push (VAPID) — хөтчийн мэдэгдэл
# -----------------------------------------------------------------------------
# Үүсгэх: `npx web-push generate-vapid-keys`
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@your-domain.com

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client.
# Authorized redirect URI: $NEXT_PUBLIC_APP_URL/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# -----------------------------------------------------------------------------
# WebRTC (видео / дуут дуудлага)
# -----------------------------------------------------------------------------
# REDIS_URL — multi-instance signaling-д ЗААВАЛ. SDP/ICE Redis-ээр fan-out.
# TURN — NAT traversal (өөр гэр-аас өөр гэр рүү) ихэвчлэн заавал.
# Зөвхөн STUN хангалтгүй.
#
# STUN (default public list бэлэн):
# STUN_URL=stun:stun.l.google.com:19302
#
# Static TURN credential:
# TURN_URL=turn:turn.example.com:3478?transport=udp
# TURN_USERNAME=
# TURN_PASSWORD=
#
# coturn `--use-auth-secret` (TURN REST):
# TURN_STATIC_AUTH_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=3600
#
# Cloudflare Realtime TURN (https://dash.cloudflare.com → Realtime → TURN Server):
# Сервер тус бүрт богино настай credential авдаг — static username/password байхгүй.
# CLOUDFLARE_TURN_TOKEN_ID=<TURN Token ID>
# CLOUDFLARE_TURN_API_TOKEN=<API Token>
# TURN_CREDENTIAL_TTL_SECONDS=3600


# =============================================================================
# 🟢 OPTIONAL — Default бэлэн, өөрчилмөөр бол set хий
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres connection pool tuning
# -----------------------------------------------------------------------------
# PgBouncer + transaction pool ашиглах бол `connection_limit=1`, иначе 10.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECT_TIMEOUT_MS=5000

# Shadow DB — `prisma migrate diff` drift detection (CI-д л хэрэгтэй).
# SHADOW_DATABASE_URL=postgresql://linksy:linksy123@localhost:5432/linksy_shadow

# Prisma query log (development-д л; production-д CPU/IO их идэшгүй).
# PRISMA_LOG_QUERIES=true

# -----------------------------------------------------------------------------
# Safe-Social moderator / admin allow-list
# -----------------------------------------------------------------------------
# Comma-separated `User.id` values. Every `/api/admin/*` route, plus the
# `isAdmin: true` flag on `GET /api/auth/me`, шалгалт хийдэг
# `isSafetyAdmin()` helper-д ашиглагдана. Хоосон → бүх admin endpoint 401.
#
# User ID-ийг олох: `npx tsx --env-file=.env scripts/find-user.ts <username>`
# жишээ: SAFETY_ADMIN_USER_IDS=cmoi74hft00020ca908jh9v5q,<another-id>
#
# Энэ нь `User.role` enum + DB column-аас өмнө хэрэглэдэг түр шийдэл
# (PROJECT_GAPS_AUDIT.md §1.1). Admin panel build хийгдсэний дараа
# DB-row рүү шилжинэ.
# SAFETY_ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# Retention crons
# -----------------------------------------------------------------------------
# AuditLog (default 365 day, 0 = disable). Daily 03:00 UTC sched-аас:
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#     $NEXT_PUBLIC_APP_URL/api/cron/audit-log-retention
# AUDIT_LOG_RETENTION_DAYS=365
# AUDIT_LOG_RETENTION_BATCH=5000

# LoginAttempt (default 90 day; security forensics window). Daily 03:15 UTC:
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#     $NEXT_PUBLIC_APP_URL/api/cron/login-attempt-retention
# LOGIN_ATTEMPT_RETENTION_DAYS=90
# LOGIN_ATTEMPT_RETENTION_BATCH=5000

# GDPR hard-delete grace days. accountDeletionRequestedAt + энэ тоо →
# `user.delete`. Min 0, max 730, default 30.
# GDPR_HARD_DELETE_GRACE_DAYS=30

# -----------------------------------------------------------------------------
# Graceful shutdown
# -----------------------------------------------------------------------------
# SIGTERM ирсний дараа SSE drain-д өгөх дээд хугацаа. k8s pod-ийн
# `terminationGracePeriodSeconds` (default 30s)-аас бага байх ёстой.
# SHUTDOWN_DRAIN_MS=20000

# -----------------------------------------------------------------------------
# Logger — pino
# -----------------------------------------------------------------------------
# Default: production → "info", dev → "debug".
# LOG_LEVEL=info
# Pretty-print human-friendly format. Production-д БҮҮ ASA: log shipper
# (Loki / Datadog / Honeycomb) JSON-stdout-аас унших ёстой.
# docs/log-aggregation.md
# PINO_PRETTY=1

# -----------------------------------------------------------------------------
# CORS — өөр origin-оос `/api` дуудах үед л
# -----------------------------------------------------------------------------
# Хоосон → апп зөвхөн өөрийн host-оосоо fetch хийнэ.
# Таслалаар тусгаарласан, яг адил origin (жнь https://app.example.com,http://localhost:5173):
# CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Android / iOS native push
# -----------------------------------------------------------------------------
# FCM (Android):
# FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# # Эсвэл 3 талбар тус тусад нь:
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
#
# APNs (iOS):
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_BUNDLE_ID=com.example.linksy
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# APNS_ENV=production  # TestFlight/dev-д: sandbox

# -----------------------------------------------------------------------------
# Translation (LibreTranslate / MyMemory)
# -----------------------------------------------------------------------------
# LIBRETRANSLATE_URL=https://libretranslate.example.com
# TRANSLATE_RATE_MAX=24
# TRANSLATE_RATE_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Push webhook relay
# -----------------------------------------------------------------------------
# HMAC-SHA256($PUSH_WEBHOOK_HMAC_SECRET, rawBody) + header
# `X-Linksy-Push-Signature: sha256=<64 hex>` шалгана.
# PUSH_WEBHOOK_HMAC_SECRET=

# -----------------------------------------------------------------------------
# CDN / Allowed remote image patterns (Next/Image)
# -----------------------------------------------------------------------------
# Таслалаар тусгаарласан origin: https://cdn.example.com,https://r2.example.com
# NEXT_PUBLIC_ALLOWED_UPLOAD_ORIGINS=


# =============================================================================
# Production deploy дараах хийх ёстой нэг удаагийн алхмууд
# =============================================================================
#
#   1. DB migration:
#        npx prisma migrate deploy
#
#      Production DB-руу 62+ migration орно. Шинэ schema column-ууд:
#         User.{gender, birthDate, autoRevealAdultContent},
#         Message.containsAdultContent,
#         Post.containsAdultContent, Story.containsAdultContent,
#         LoginAttempt model.
#
#   2. Stripe Dashboard → Developers → Webhooks → Add endpoint
#        URL: $NEXT_PUBLIC_APP_URL/api/webhooks/stripe
#        Events: checkout.session.completed,
#                customer.subscription.{created,updated,deleted,
#                                       trial_will_end,paused,resumed},
#                invoice.payment_{succeeded,failed},
#                payment_intent.{succeeded,failed,canceled}
#      Signing secret-ийг STRIPE_WEBHOOK_SECRET-руу хуул.
#
#   3. Stripe Dashboard → Settings → Customer Portal → Enable +
#      $NEXT_PUBLIC_APP_URL/settings зөвшөөрөгдсөн return URL.
#
#   4. Stripe Dashboard → Settings → Emails → асаах:
#        "Successful payments" / "Failed payments" (receipt email).
#
#   5. Эхний админ хэрэглэгч (admin panel build хийсний дараа):
#        UPDATE "User" SET role = 'ADMIN' WHERE email = '<your admin email>';
#
#   6. Cron schedule — PROJECT_GAPS_AUDIT.md §5 дотор crontab.
#      k8s CronJob эсвэл provider's scheduler (Vercel Cron, GitHub Actions
#      schedule, AWS EventBridge) дамжуулан хэрэгжүүл.
#
#   7. Prometheus scrape config (k8s + kube-prometheus-stack жишээ):
#        - job_name: linksy
#          bearer_token: $METRICS_AUTH_TOKEN
#          metrics_path: /api/metrics
#          scrape_interval: 15s
#          static_configs:
#            - targets: ['linksy-web:3000']
#
#   8. DNS + TLS:
#        A/AAAA record → load balancer IP
#        Wildcard cert (cert-manager + Let's Encrypt) — apex + www.
#
#   9. Email DNS records (Resend dashboard):
#        SPF:   v=spf1 include:_spf.resend.com -all
#        DKIM:  CNAME provided by Resend
#        DMARC: v=DMARC1; p=quarantine; rua=mailto:postmaster@your-domain.com
#
#  10. Smoke test (production):
#        register → verify email → login → create post → DM → tip → logout.
#
#  11. Backup drill (1-р долоо хоног дотор):
#        `scripts/pg-restore.example.sh` нь staging-руу production backup
#        restore хийж тест. Docs: docs/backup-and-restore.md
#
# Дэлгэрэнгүй: PROJECT_GAPS_AUDIT.md §4 "Production ENV Checklist" + §5
# "Pre-launch Checklist".
