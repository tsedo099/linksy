{
  "name": "diplom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"lib/**/*.test.ts\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"components/__tests__/**/*.tsx\" \"*.config.ts\" \"vitest.setup.ts\" \"playwright.config.ts\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "format:check": "prettier --check \"lib/**/*.test.ts\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"components/__tests__/**/*.tsx\" \"*.config.ts\" \"vitest.setup.ts\" \"playwright.config.ts\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build",
    "seed": "tsx prisma/seed.ts",
    "worker:email": "tsx scripts/email-worker.ts",
    "audit:n1": "tsx scripts/analyze-prisma-log.ts",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "stories": "ladle serve",
    "stories:build": "ladle build",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1044.0",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@sentry/nextjs": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@stripe/react-stripe-js": "^4.0.2",
    "@stripe/stripe-js": "^7.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.6",
    "dompurify": "^3.4.2",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.0.1",
    "ioredis": "^5.10.1",
    "isomorphic-dompurify": "^3.12.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "pino": "^10.3.1",
    "prisma": "^7.7.0",
    "prom-client": "^15.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.75.0",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7",
    "web-vitals": "^5.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "^3.3.5",
    "@ladle/react": "^5.0.3",
    "@next/bundle-analyzer": "^16.2.5",
    "@playwright/test": "^1.59.1",
    "@size-limit/file": "^11.2.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.11",
    "msw": "^2.14.5",
    "pino-pretty": "^11.3.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.3",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
