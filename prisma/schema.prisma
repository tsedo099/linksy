}

/**
 * Per-user long-term identity for E2EE DMs. Stores ONLY public material.
 *
 * `identitySigningKey` is an ECDSA P-256 SPKI used to verify the signed
 * prekey signature. `identityExchangeKey` is an ECDH P-256 SPKI consumed by
 * peers performing X3DH key agreement. Rotated when the user re-bootstraps
 * (e.g. new device — old device's IndexedDB-stored private keys are gone).
 */
model E2EEIdentity {
  userId                  String   @id
  identitySigningKey      String   @db.Text
  identityExchangeKey     String   @db.Text
  signedPreKeyId          Int
  signedPreKeyPublic      String   @db.Text
  signedPreKeySignature   String   @db.Text
  signedPreKeyCreatedAt   DateTime
  updatedAt               DateTime @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oneTimePreKeys E2EEOneTimePreKey[]
  devices        E2EEDevice[]
}

/**
 * Pool of single-use ECDH P-256 prekeys. Server hands one out per X3DH
 * session and marks `consumedAt` so it's never reused. Client refreshes the
 * pool when it falls below a threshold.
 *
 * Multi-device note: when `deviceId` is set, this prekey belongs to a specific
 * device's keyring (so other devices' sessions don't consume it). Legacy
 * single-device rows (deviceId = NULL) remain valid for backward compat —
 * `consumeOneTimePreKey` on the server falls through to them when the device
 * has none of its own.
 */
model E2EEOneTimePreKey {
  id         String    @id @default(cuid())
  userId     String
  preKeyId   Int
  publicKey  String    @db.Text
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  deviceId   String?

  identity E2EEIdentity @relation(fields: [userId], references: [userId], onDelete: Cascade)
  device   E2EEDevice?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, preKeyId])
  @@index([userId, consumedAt])
  @@index([deviceId, consumedAt])
}

/**
 * Per-device identity bundle. A user with N installed devices (web, iOS,
 * Android) publishes one row per device — each with its own ECDSA signing key,
 * ECDH exchange key, signed pre-key, and one-time prekey pool. When User A
 * sends a message to User B, the client fanout-encrypts once per recipient
 * device (including A's other devices, so cross-device read state stays in
 * sync).
 *
 * See [docs/e2ee-multi-device.md](docs/e2ee-multi-device.md) for the
 * end-to-end protocol.
 */
/**
 * Records that a user manually verified the safety number for a peer.
 * `peerIdentityFingerprint` is the SHA-256 of the peer's identity signing
 * key at the time of verification — server invalidates the row when the
 * peer publishes a new identity key (fingerprint mismatch on read).
 */
model E2EEVerification {
  userId                  String
  peerUserId              String
  peerIdentityFingerprint String   @db.Text
  verifiedAt              DateTime @default(now())
  /** Re-verification required when this is true (peer rotated their identity key). */
  stale                   Boolean  @default(false)

  user User @relation("E2EEVerificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  peer User @relation("E2EEVerificationPeer", fields: [peerUserId], references: [id], onDelete: Cascade)

  @@id([userId, peerUserId])
  @@index([peerUserId])
}

/**
 * One-shot tip between two users (Stripe PaymentIntent fronted). `amount` is
 * always in the smallest currency unit (e.g. cents for USD) per Stripe convention.
 * `status` mirrors PaymentIntent state machine: PENDING → SUCCEEDED | FAILED | REFUNDED.
 */
model Tip {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  /** Smallest currency unit (cents). Stripe is the source of truth for the actual charge. */
  amount    Int
  currency  String   @default("USD")
  message   String?
  status    String   @default("PENDING")
  stripePaymentIntentId String? @unique
  createdAt DateTime @default(now())
  /** When the PaymentIntent finalized (any terminal state). */
  settledAt DateTime?

  fromUser User @relation("TipSender", fields: [fromId], references: [id], onDelete: Cascade)
  toUser   User @relation("TipRecipient", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId, createdAt])
  @@index([fromId, createdAt])
  @@index([status])
}

model E2EEDevice {
  id                    String   @id @default(cuid())
  userId                String
  /** Human-readable label shown in Settings → Devices (e.g. "Chrome on macOS"). */
  label                 String
  /** "WEB" | "IOS" | "ANDROID" | "DESKTOP" — opaque to the server. */
  platform              String
  identitySigningKey    String   @db.Text
  identityExchangeKey   String   @db.Text
  signedPreKeyId        Int
  signedPreKeyPublic    String   @db.Text
  signedPreKeySignature String   @db.Text
  signedPreKeyCreatedAt DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  /** Set when the user revokes this device from Settings. Server refuses to hand out its keys. */
  revokedAt             DateTime?

  identity       E2EEIdentity        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  oneTimePreKeys E2EEOneTimePreKey[]

  @@index([userId, revokedAt])
}

