/**
 * Stripe-event idempotency log. Webhook handler inserts the event ID before
 * processing; a unique-constraint conflict means the event was already handled.
 */
model ProcessedWebhookEvent {
  /** Stripe event ID (`evt_...`). */
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

/**
 * Append-only log of every login attempt — successful or not — for
 * rate-limiting forensics, account-takeover detection, and the
 * "recent sign-ins" UI in account settings.
 *
 * `email` is stored lowercased as observed at the boundary (we *don't*
 * resolve to userId because failed attempts may target non-existent
 * accounts and we want to surface that pattern). For privacy, the row
 * is purged 90 days after `attemptedAt` by the
 * `prisma/migrations/.../login_attempt_retention` cron (see RUNBOOK).
 */
model LoginAttempt {
  id          String   @id @default(cuid())
  email       String
  ipAddress   String?
  /** "password" | "totp" | "passkey" | "backup_code" | "oauth_google" — opaque. */
  channel     String   @default("password")
  succeeded   Boolean
  /** Short machine-readable reason on failure: "bad_password" | "no_user" | "locked" | "2fa_required" | "2fa_failed" | "rate_limited". `null` on success. */
  failureReason String?
  userAgent   String?
  /** Populated only when authentication resolved to a real user (succeeded or known-email failure). */
  userId      String?
  attemptedAt DateTime @default(now())

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@index([userId, attemptedAt])
  @@index([attemptedAt])
}

/**
 * Daily AI request counter per user. Keyed by `(userId, day)` where `day` is a
 * UTC `YYYY-MM-DD` string — keeps the table small (one row per user per day)
 * and avoids timezone math at query time. Cleanup is best-effort; rows older
 * than a couple of weeks can be pruned by a cron without affecting quota.
 */
model AiUsage {
  userId String
  day    String
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}
